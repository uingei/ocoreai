--- a/Sources/ocoreai/Tools/ExecSessions.swift
+++ b/Sources/ocoreai/Tools/ExecSessions.swift
@@ -514,7 +514,14 @@ actor ExecSessionManager {
             parts.append(err)
         }
         parts.append("end of process output")
-        parts.append("exit code: \(session.completed ? session.exitCode : -1)")
+        let code: Int32 = session.completed ? session.exitCode : -1
+        parts.append("exit code: \(code)")
+        // The same 127 fact the pinned lane states — one contract for both exec surfaces.
+        if session.completed,
+            let hint = ExecNotFoundHint.suffix(exitCode: code, stderr: session.stderr)
+        {
+            parts.append(hint)
+        }
         return parts.joined(separator: "\n")
     }
 
