+    /// Same type coverage as `check`, decided from the bytes alone — nothing touches the disk.
+    /// This exists for the one caller that must decide before a write (`FileTools`
+    /// `syntaxRegression`); every result suffix keeps using `check`, which judges the file
+    /// actually on disk.
+    static func sourceVerdict(path: String, content: String) -> Verdict? {
+        let ext = (path as NSString).pathExtension.lowercased()
+        switch ext {
+        case "json":
+            return jsonVerdict(content)
+        case "plist":
+            return plistVerdict(content)
+        case "py":
+            return pythonSourceVerdict(
+                name: (path as NSString).lastPathComponent, source: content)
+        default:
+            return nil
+        }
+    }
+
+    /// `compile(source, name, "exec")` fed over stdin — the same grammar `py_compile` applies
+    /// to the file, decided without writing it. `compile()` rather than `ast.parse()`: only
+    /// `compile()` rejects a `return` outside a function, so a string verdict and the later
+    /// file verdict cannot disagree about the same bytes.
+    static func pythonSourceVerdict(name: String, source: String) -> Verdict {
+        #if !os(macOS)
+        _ = (name, source)
+        return .notChecked("no subprocess on this platform — syntax not checked")
+        #else
+        guard let exe = pythonExecutable else {
+            return .notChecked("python unavailable here — syntax not checked")
+        }
+        let proc = Process()
+        proc.executableURL = URL(fileURLWithPath: exe)
+        proc.arguments = [
+            "-c", "import sys; compile(sys.stdin.read(), sys.argv[1], \"exec\")", name,
+        ]
+        let inPipe = Pipe()
+        let errPipe = Pipe()
+        proc.standardInput = inPipe
+        proc.standardError = errPipe
+        proc.standardOutput = Pipe()
+        do {
+            try proc.run()
+        } catch {
+            return .notChecked("python could not run (\(clip(error.localizedDescription)))")
+        }
+        // Write then close: `sys.stdin.read()` returns only at EOF, so a pipe left open
+        // would park this thread to the deadline on a perfectly valid file.
+        inPipe.fileHandleForWriting.write(Data(source.utf8))
+        inPipe.fileHandleForWriting.closeFile()
+        let deadline = Date().addingTimeInterval(timeoutSeconds)
+        while proc.isRunning, Date() < deadline {
+            Thread.sleep(forTimeInterval: 0.02)
+        }
+        if proc.isRunning {
+            proc.terminate()
+            return .notChecked("compile timed out after \(Int(timeoutSeconds))s — no verdict")
+        }
+        if proc.terminationStatus == 0 {
+            return .valid("compile OK")
+        }
+        let raw = errPipe.fileHandleForReading.readDataToEndOfFile()
+        let text = String(data: raw, encoding: .utf8) ?? ""
+        let line = text.split(separator: "\n").last.map(String.init) ?? "compile error"
+        return .invalid("compile FAILED — \(clip(line))")
+        #endif
+    }
+
