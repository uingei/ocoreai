+    /// A file that compiled may not stop compiling by the tool's own hand.
+    ///
+    /// Measured 11-08 (`fix-off-by-one-slice`, six-arm board run): `edit_lines` replaced a whole
+    /// valid `.py` with an orphan-indented fragment; the post-write verdict said `OK-but-invalid`
+    /// with the compiler's `IndentationError` in the same result, and two seconds later the turn
+    /// answered "has been fixed" over a verify_rc=1 artefact. Reporting after the write is
+    /// measured-ignored, and making the duty a prompt sentence measured a clean negative
+    /// (`scripts/eval/proposals/verify-before-done.md`, p=1.00), so the truth moves before the
+    /// write: only a valid→broken regression of a decidable type refuses, and the old bytes stay
+    /// on disk. Broken→fixed, fixed→fixed, broken→broken and new files write exactly as before.
+    /// Returns the compiler's reason, or `nil` when this write is not a regression.
+    static func syntaxRegression(path: String, oldContent: String, newContent: String) -> String? {
+        guard !oldContent.isEmpty,
+            let was = PostWriteSyntax.sourceVerdict(path: path, content: oldContent),
+            case .valid = was,
+            let now = PostWriteSyntax.sourceVerdict(path: path, content: newContent),
+            case .invalid(let why) = now
+        else { return nil }
+        return why
+    }
+
+    /// The refusal's wording, homed once because three write sites read it. A fragment that is
+    /// genuinely the goal still has a route that exists today — a new path — so the refusal
+    /// closes nothing (the `rm`-offer discipline: name an exit only the caller's own facts show).
+    static func syntaxRegressionRefusal(tool: String, path: String, why: String) -> String {
+        "\(tool): refusing to break valid syntax — \(path) is valid today and these bytes are not"
+            + " (\(why)). Nothing was written; the file still holds its old bytes. Retry this call"
+            + " with text that keeps the file valid; if this text is meant to be a fragment, it"
+            + " belongs at a new path."
+    }
