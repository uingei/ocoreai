+// Copyright © 2026 uingei@163.com.
+// Licensed under MIT.
+/// The syntax-regression gate — a file that compiled may not stop compiling by the tool's hand.
+///
+/// Measured 11-08 (`fix-off-by-one-slice`, six-arm board run, `scripts/eval/`): `edit_lines`
+/// replaced the whole valid `page.py` with the orphan-indented fragment `    return items[:n]`;
+/// the write landed, the result said `OK-but-invalid — … py_compile FAILED — IndentationError`,
+/// and the turn two seconds later answered "The slice in `page.py` has been fixed." over a
+/// verify_rc=1 artefact. The post-write report is measured-ignored and the prompt-sentence
+/// alternative measured a clean negative (`scripts/eval/proposals/verify-before-done.md`), so
+/// this gate decides before the write. These tests pin the refusal's exact text, the surviving
+/// bytes, and — the half that must stay silent — every transition the gate may not touch.
+import Foundation
+import Testing
+
+@testable import ocoreai
+
+@Suite(
+    "syntax regression gate — valid→broken refuses, every other transition writes",
+    .serialized)
+struct SyntaxRegressionGateTests {
+
+    private func tempDir() throws -> String {
+        let dir = NSTemporaryDirectory() + "ocoreai-syntaxgate-\(UUID().uuidString)"
+        try FileManager.default.createDirectory(atPath: dir, withIntermediateDirectories: true)
+        return dir
+    }
+
+    @discardableResult
+    private func seed(_ dir: String, _ name: String, _ body: String) throws -> Data {
+        let url = URL(fileURLWithPath: dir).appendingPathComponent(name)
+        let bytes = Data(body.utf8)
+        try bytes.write(to: url)
+        return bytes
+    }
+
+    private func bytesAt(_ dir: String, _ name: String) throws -> Data {
+        try Data(contentsOf: URL(fileURLWithPath: dir).appendingPathComponent(name))
+    }
+
+    /// The exact bytes the 11-08 incident left and consumed.
+    private static let pageValid =
+        "def first_n(items, n):\n    return items[0:n - 1]\n"
+    private static let pageFragment = "    return items[:n]\n"
+
+    @Test(
+        "the incident replayed: the orphan-fragment edit_lines is refused and page.py keeps its bytes",
+        .enabled(if: PostWriteSyntax.pythonExecutable != nil))
+    func editLinesFragmentRefused() throws {
+        let dir = try tempDir()
+        defer { try? FileManager.default.removeItem(atPath: dir) }
+        let original = try seed(dir, "page.py", Self.pageValid)
+
+        var message = ""
+        do {
+            _ = try FileTools.editLines(
+                path: dir + "/page.py", startLine: 1, endLine: 2,
+                newText: "    return items[:n]")
+            Issue.record("the fragment write must be refused")
+        } catch let ToolError.invalidParameter(text) {
+            message = text
+        }
+        #expect(message.hasPrefix("edit_lines: refusing to break valid syntax"))
+        #expect(message.contains("compile FAILED — IndentationError"), "\(message)")
+        #expect(message.contains("Nothing was written"), "\(message)")
+        // The refusal names the exits that exist: retry, and the fragment's own path.
+        #expect(message.contains("belongs at a new path"), "\(message)")
+        #expect(try bytesAt(dir, "page.py") == original)
+    }
+
+    @Test(
+        "edit_file refuses the same regression and leaves the file byte-identical",
+        .enabled(if: PostWriteSyntax.pythonExecutable != nil))
+    func editFileFragmentRefused() throws {
+        let dir = try tempDir()
+        defer { try? FileManager.default.removeItem(atPath: dir) }
+        let original = try seed(dir, "page.py", Self.pageValid)
+
+        #expect(throws: (any Error).self) {
+            _ = try FileTools.editFile(
+                path: dir + "/page.py",
+                oldString: "def first_n(items, n):\n    return items[0:n - 1]",
+                newString: "    return items[:n]")
+        }
+        #expect(try bytesAt(dir, "page.py") == original)
+    }
+
+    @Test(
+        "write_file over a valid .py with non-compiling bytes is refused",
+        .enabled(if: PostWriteSyntax.pythonExecutable != nil))
+    func writeFileRegressionRefused() throws {
+        let dir = try tempDir()
+        defer { try? FileManager.default.removeItem(atPath: dir) }
+        let original = try seed(dir, "page.py", Self.pageValid)
+
+        var message = ""
+        do {
+            _ = try FileTools.write(path: dir + "/page.py", content: Self.pageFragment)
+            Issue.record("the overwrite must be refused")
+        } catch let ToolError.invalidParameter(text) {
+            message = text
+        }
+        #expect(message.hasPrefix("write_file: refusing to break valid syntax"))
+        #expect(try bytesAt(dir, "page.py") == original)
+    }
+
+    @Test(
+        "the fix direction still writes: broken→fixed reports OK, not a refusal",
+        .enabled(if: PostWriteSyntax.pythonExecutable != nil))
+    func brokenToFixedWrites() throws {
+        let dir = try tempDir()
+        defer { try? FileManager.default.removeItem(atPath: dir) }
+        try seed(dir, "page.py", Self.pageFragment)
+
+        let out = try FileTools.editLines(
+            path: dir + "/page.py", startLine: 1, endLine: 1,
+            newText: "def first_n(items, n):\n    return items[:n]")
+        #expect(out.contains("edit_lines: OK —"), "\(out)")
+        #expect(out.contains("syntax: py_compile OK"), "\(out)")
+        #expect(
+            try String(
+                contentsOfFile: dir + "/page.py", encoding: .utf8)
+                == "def first_n(items, n):\n    return items[:n]\n")
+    }
+
+    @Test(
+        "a new broken .py is created, not refused — the gate only stops regressions",
+        .enabled(if: PostWriteSyntax.pythonExecutable != nil))
+    func newFileStaysUnrefused() throws {
+        let dir = try tempDir()
+        defer { try? FileManager.default.removeItem(atPath: dir) }
+
+        let out = try FileTools.write(path: dir + "/fragment.py", content: Self.pageFragment)
+        #expect(out.contains("write_file: OK-but-invalid"), "\(out)")
+        #expect(out.contains("created"), "\(out)")
+        #expect(try bytesAt(dir, "fragment.py") == Data(Self.pageFragment.utf8))
+    }
+
+    @Test("json refuses valid→unparseable with the decoder's words")
+    func jsonRegressionRefused() throws {
+        let dir = try tempDir()
+        defer { try? FileManager.default.removeItem(atPath: dir) }
+        let original = try seed(dir, "cfg.json", #"{"a": 1}"#)
+
+        var message = ""
+        do {
+            _ = try FileTools.editFile(
+                path: dir + "/cfg.json", oldString: "1", newString: "}")
+            Issue.record("valid→unparseable json must be refused")
+        } catch let ToolError.invalidParameter(text) {
+            message = text
+        }
+        #expect(message.hasPrefix("edit_file: refusing to break valid syntax"))
+        #expect(message.contains("JSON invalid"), "\(message)")
+        #expect(try bytesAt(dir, "cfg.json") == original)
+    }
+
+    @Test(
+        "undecidable types are untouched — bytes that break a .py write fine as .txt")
+    func undecidableTypesStaySilent() throws {
+        let dir = try tempDir()
+        defer { try? FileManager.default.removeItem(atPath: dir) }
+        try seed(dir, "note.txt", "def first_n(items, n):\n    return items[0:n - 1]\n")
+
+        let out = try FileTools.editLines(
+            path: dir + "/note.txt", startLine: 1, endLine: 2,
+            newText: Self.pageFragment.trimmingCharacters(in: .newlines))
+        #expect(out.contains("edit_lines: OK —"), "\(out)")
+        #expect(
+            try String(contentsOfFile: dir + "/note.txt", encoding: .utf8)
+                == Self.pageFragment)
+    }
+
+    @Test("the gate's premise is stated, not assumed: json decides in-process, py only with python")
+    func gatePremisesAreHonest() {
+        // If python is absent here, the py gate must fall to silence (`.notChecked` is neither
+        // valid nor invalid), and that must be a visible skip in this suite, never a vacuous pass.
+        #expect(
+            PostWriteSyntax.sourceVerdict(path: "x.json", content: #"{"a": 1}"#)?.failed == false)
+        #expect(PostWriteSyntax.sourceVerdict(path: "x.txt", content: "anything") == nil)
+        if PostWriteSyntax.pythonExecutable == nil {
+            #expect(
+                PostWriteSyntax.sourceVerdict(path: "x.py", content: "def f(:")?.headline
+                    .contains("not checked") == true)
+        } else {
+            #expect(
+                PostWriteSyntax.sourceVerdict(path: "x.py", content: "def f(:")?.failed == true,
+                "with python present the source verdict must decide, not abstain")
+            #expect(
+                PostWriteSyntax.sourceVerdict(path: "x.py", content: "def f():\n    return 1\n")?
+                    .headline == "compile OK")
+            // compile(), not ast.parse(): a return outside a function is only a syntax error
+            // to compile(), and the post-write py_compile agrees — the two verdicts cannot
+            // disagree about the same bytes.
+            #expect(
+                PostWriteSyntax.sourceVerdict(path: "x.py", content: "return 1")?.failed == true)
+        }
+    }
+}
