[codespell]
# Domain vocabulary this project deliberately writes, each entry a fact rather than a slip:
# ANE = Apple Neural Engine; inout = Swift keyword; caf = Core Audio Format; ND = n-dimensional;
# ans = the answer variable in scripts/probes; numer = mach_timebase_info_data_t's own field
# (Apple's header, not ours); datas = the local name for a [Data] batch; checkin = the
# checkout/checkin handle pattern; unparseable is this repo's term of art; re-declaring and
# allReady/ot-style camelCase entries are identifiers. Same convention as sglang/.codespellrc
# and codex/.codespellrc — a spell gate is only affordable if the vocabulary is stated once.
# The last two are test payloads, not vocabulary, and correcting either one silently disarms a gate:
# `temprature` is the near-miss field name DecisionsContractTests and probe 49 must refuse *by name*
# (spelled right it becomes the real `temperature` and nothing is refused), and `probabilit` is the stem
# probe 49 scans refusal bodies with, so it has to stay a stem. `cach` is the same case one layer down:
# a regex stem in scripts/comparator-consensus.sh's KV axis that has to match cache|caching|cached, so
# spelling it out would narrow what the instrument can see. `truncat` is the kv_context stem in
# docs/agent/comparator-evolution.md's failure-taxonomy pattern (must match truncation/truncated/
# truncates) — the same instrument-stem class. `summar` and `integrat` are that same file's
# churn buckets (must match summary/summarization, integrate/integration); they arrived with the 11-04
# bucket split and the gate stayed red until 11-05 because nobody ran `make spell` that round.
# Dead alternatives are deleted, not registered: `changlog` sat in the deps/release alternation and
# matched nothing — no path in any of the 28 comparator trees is spelled that way (`find ~/references
# -iname '*changlog*'` = empty), so it was a typo in a regex, not a stem with a purpose.
# `elease` is the same instrument-stem class one file over: the `[Rr]elease` character-class in
# scripts/audit-facts.sh's changelog-tax regex must stay a class so it matches Release/release
# in tracked paths; codespell reads the class body as a bare misspelling of `release`.
# `aci` is a quoted title, not our prose: the SWE-agent row quotes that tree's own thesis name
# "the ACI thesis" (its README's "Agent-Computer Interfaces Enable Automated Software Engineering"),
# at docs/agent/comparator-repos.md:533 — rewriting an acronym we are quoting would misquote the quote.
ignore-words-list = ane,caf,nd,ans,inout,unparseable,uptodate,ontext,allready,optionall,reuseable,alloc,datas,checkin,numer,re-declaring,temprature,probabilit,cach,truncat,summar,integrat,aci,elease
# Vendored and generated surfaces are not ours to reword: CXGrammar + dlpack are upstream C,
# THIRD-PARTY-LICENSES is collected verbatim, and .build is a resolved dependency cache. The diary
# is skipped for a different reason: it quotes the misspellings it recorded, as evidence, and
# rewording history to satisfy a spell gate would falsify the record. This file is skipped too
# (as codex does) for the same reason — a rule that explains itself by quoting a typo must not
# be tripped by its own explanation.
skip = .git*,.build*,.build-clt*,Sources/lib/*,*dlpack*,THIRD-PARTY-LICENSES/*,.codespellrc,CHANGELOG.md,IDEA.md,*.json,*.jsonl,*.lock,*.png,*.icns,*.metallib,*.svg,Package.resolved
check-hidden = true
