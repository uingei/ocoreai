# ocoreai 环境变量模板 (.env.example)
#
# 复制为 .env 或写入 shell 环境。优先级: env var > ~/.ocoreai/config.yaml > 内置默认。
# 行尾 `# 默认: …` 是代码当前实际默认值(行号 = 真实来源,详见括号注)。
# 标 [MUST-OVERRIDE] 的项不设置即指向无效/演示地址,使用前必须改。
#
# 守卫: Tests/ocoreaiTests/EnvKeysDocumentationTests 锁死「本文件键集 == Sources/ 读键集」,
# 代码新增/删除 env 键而未同步本文件(或反之)即测试红。

# ── Server ─────────────────────────────────────────────────────────────
OCOREAI_HOST=127.0.0.1                    # App.swift:816 默认 127.0.0.1;非 loopback 无 auth 会被 ServerAuthGate 拒绝
OCOREAI_PORT=8080                         # App.swift:623/691/817 默认 8080

# ── Auth ───────────────────────────────────────────────────────────────
OCOREAI_API_KEYS=                         # AuthMiddleware.swift:44;逗号分隔;空=关闭鉴权
OCOREAI_ADMIN_KEYS=                       # AuthMiddleware.swift:45;逗号分隔;门控 PATCH/DELETE;可选

# ── Backend (ConfigSystem.applyEnvOverrides, ConfigSystem.swift:195-222) ──
OCOREAI_BACKEND=                          # 单值 coreai|mlx;覆盖 yaml backend.preference(默认顺序 [coreai, mlx])
OCOREAI_MAX_SESSIONS=                     # 正整数;覆盖 yaml maxConcurrentSessions
OCOREAI_DEFAULT_MODEL=                    # 覆盖 yaml models.default.modelId(默认 mlx-community/gemma-4-e2b-it-4bit)
OCOREAI_MEMORY_ENABLED=true               # "false" 关闭会话记忆;默认启用

# ── Model 存储 / 工作树 ────────────────────────────────────────────────
OCOREAI_MODELS_DIR=                       # ModelStore.swift:57;默认 ~/.ocoreai/models(omlx ~/.omlx/models 同构)
OCOREAI_WORKTREE_ROOT=                    # SessionWorkspace.swift:144;默认 ~/ocoreai-worktrees(codex 对齐的托管根)
OCOREAI_PROJECT_DIR=                      # FileSystemSensor.swift:116;可选;追加到文件监听路径

# ── HuggingFace ────────────────────────────────────────────────────────
HF_TOKEN=                                 # App.swift:274;访问 gated 仓库;可选
HF_ENDPOINT=                              # App.swift:257;镜像/proxy(受限区);优先级最高
HF_ENDPOINT_MIRROR=                       # App.swift:258;HF_ENDPOINT 未设时的回退源

# ── ModelScope ─────────────────────────────────────────────────────────
MODELSCOPE_TOKEN=                         # App.swift:271;ModelScope gated 仓库;可选
MODELSCOPE_ENDPOINT=https://modelscope.cn # ModelStore.modelScopeDefaultBaseURL 单一真源(非 www 别名域)

# ── web_search / web_fetch (本地 ollama 后端) ──────────────────────────
# [MUST-OVERRIDE] 代码默认指向作者演示局域网机,他人开箱必失效——请改为你自己的 ollama 地址。
OCRE_SEARCH_BASE_URL=                     # WebSearchTool.swift:268;默认 http://192.168.101.146:11434/v1 [MUST-OVERRIDE]
OCRE_SEARCH_MODEL=qwen3.8:27b-mtp         # WebSearchTool.swift:269;ollama 侧执行搜索的模型
OCRE_SEARCH_TIMEOUT=180                   # WebSearchTool.swift:270;秒
OCRE_SEARCH_PROBE_TIMEOUT=5               # WebSearchTool.swift:242;后端探活超时(秒)
OCRE_FETCH_TIMEOUT=30                     # WebFetchTool.swift:76;秒;夹在 1..120
