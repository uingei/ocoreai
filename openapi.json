  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization: Bearer <key> — the primary route."
      },
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "api-key",
        "description": "OpenAI-compatible fallback, checked second."
      },
      "apiKeyQuery": {
        "type": "apiKey",
        "in": "query",
        "name": "api_key",
        "description": "Debug convenience, checked last."
      }
    },
    "responses": {
      "AppError": {
        "description": "Envelope emitted by AppError.response and RouteNotFoundError: always `message`, `type`, `code`, plus the typed keys the failure earns (`error_code`, `remediation`, `param`, `value`, `details`, `retry_after_seconds`, `post_tokens`/`cap`, `used_gb`/`budget_gb`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type",
              "code"
            ],
            "additionalProperties": true,
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "app_error",
                  "invalid_request_error",
                  "rate_limit_error"
                ]
              },
              "code": {
                "type": "integer"
              },
              "error_code": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
