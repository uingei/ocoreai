#!/usr/bin/env bash
# pre-push — fast gate before push
# debug build (not release) — release takes too long on every push
# tests — last line must report "passed after"

echo "🔧 Pre-push: debug build..."
BUILD_OK=$(swift build 2>&1 | tail -1 | grep -c "Build complete")
if [ "$BUILD_OK" -eq 0 ]; then
  echo "⚠️  Incremental build failed — retrying clean build..."
  rm -rf .build
  BUILD_OK=$(swift build 2>&1 | tail -1 | grep -c "Build complete")
fi
if [ "$BUILD_OK" -eq 0 ]; then
  echo "❌ Build failed"
  exit 1
fi

echo "🧪 Pre-push: tests..."
# Swift Testing exits 1 when MLX metallib warning appears even if all tests pass.
# Check for actual test assertion failures, not framework noise.
# A real failure shows "Test Suite 'All tests' failed" or "Recorded test failure".
TEST_OUT=$(swift test 2>&1)
# Match "All tests" summary line — if it says "passed" we're green
ALL_PASSED=$(echo "$TEST_OUT" | grep "Test Suite 'All tests' passed" | grep -c "")
if [ "$ALL_PASSED" -eq 1 ]; then
  echo "✅ Pre-push: tests passed"
else
  echo "❌ Tests failed"
  echo "$TEST_OUT" | grep -E "Recorded test failure|Test Suite.*failed|errored" | tail -20
  exit 1
fi

echo "✅ Pre-push: green"
